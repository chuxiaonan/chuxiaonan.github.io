---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import WorkCase from "../components/WorkCase.astro";
import ProjectCards from "../components/ProjectCards.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { site, intro } from "../data/site";
const posts = (await getPosts()).slice(0, 3);
const focus = [
  ["01", "渲染", "图形渲染与可视化"],
  ["02", "三维建模", "三维空间与模型表达"],
  ["03", "地理信息", "地理信息与 Web 地图技术"],
  ["04", "仿真", "仿真与虚拟世界构建"],
  ["05", "工程与协作", "工程落地与团队协作"],
];
---

<Base>
  <Hero />
  <div class="hatch" aria-hidden="true"></div>
  <section id="intro" class="section rule-top">
    <div class="wide">
      <p class="figure-label">Figure 01 / 简介</p>
      <h2 class="section-title">以技术构建，在空间中探索。</h2>
      <div class="intro-copy">
        <p>{intro.zh}</p>
        <p lang="en">{intro.en}</p>
        <a class="text-link" href="/about/">更多关于我</a>
      </div>
    </div>
  </section>
  <div class="hatch" aria-hidden="true"></div>
  <section class="section rule-top">
    <div class="wide">
      <p class="figure-label">Figure 02 / 技术方向</p>
      <h2 class="section-title">从像素到空间，从代码到协作。</h2>
      <div class="practice-grid">
        {
          focus.map(([n, zh, desc]) => (
            <article class="practice-item">
              <span class="practice-index">{n}</span>
              <h3>{zh}</h3>
              <p>{desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <div class="hatch" aria-hidden="true"></div>
  <section class="section rule-top">
    <div class="wide">
      <div class="section-heading">
        <div>
          <p class="figure-label">Figure 03 / 工作</p>
          <h2 class="section-title">工作</h2>
        </div>
        <a class="text-link" href="/projects/">全部工作</a>
      </div>
      <WorkCase />
      <div class="archive-block">
        <h3 class="archive-heading">本站源码</h3>
        <ProjectCards variant="compact" />
      </div>
    </div>
  </section>
  <div class="hatch" aria-hidden="true"></div>
  <section class="section rule-top">
    <div class="wide">
      <div class="section-heading">
        <div>
          <p class="figure-label">Figure 04 / 笔记</p>
          <h2 class="section-title">最近文章</h2>
        </div>
        <a class="text-link" href="/blog/">全部文章</a>
      </div>
      <PostList posts={posts} />
    </div>
  </section>
  <div class="hatch" aria-hidden="true"></div>
  <section class="contact rule-top">
    <div class="wide">
      <div>
        <p class="figure-label">Figure 05 / 连接</p>
        <h2>保持连接。</h2>
      </div>
      <a class="contact-link" href={site.github} rel="noopener noreferrer">
        GitHub
        <small>github.com/chuxiaonan</small>
      </a>
    </div>
  </section>
</Base>
