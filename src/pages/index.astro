---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ProjectCards from "../components/ProjectCards.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { site, intro } from "../data/site";
const posts = (await getPosts()).slice(0, 3);
const focus = [
  [
    "01",
    "渲染",
    "Rendering",
    "图形渲染与可视化",
    "Graphics rendering & visualization",
  ],
  [
    "02",
    "三维建模",
    "3D Modeling",
    "三维空间与模型表达",
    "Spatial & model representation",
  ],
  [
    "03",
    "地理信息",
    "GIS & Web Mapping",
    "地理信息与 Web 地图技术",
    "Geographic information & web maps",
  ],
  [
    "04",
    "前端工程",
    "Engineering & Leadership",
    "前端工程与团队管理",
    "Front-end engineering & team leadership",
  ],
];
---

<Base>
  <Hero />
  <section id="intro" class="container section intro">
    <div>
      <p class="eyebrow">01 / INTRODUCTION</p>
      <h2>
        以技术构建，
        <br />
        在空间中探索<span class="accent">。</span>
      </h2>
      <p class="section-subtitle" lang="en">
        Building with code. Thinking in space.
      </p>
    </div>
    <div class="intro-copy">
      <p>{intro.zh}</p>
      <p lang="en">{intro.en}</p>
      <a class="text-link" href="/about/">
        更多关于我 <span>About me ↗</span>
      </a>
    </div>
  </section>
  <section class="focus-section">
    <div class="container section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / FOCUS AREAS</p>
          <h2>
            技术方向 <span lang="en">Focus areas</span>
          </h2>
        </div>
        <p class="small-note">
          从像素到空间，从代码到协作。
          <br />
          <span lang="en">Pixels, spaces, code & collaboration.</span>
        </p>
      </div>
      <div class="focus-grid">
        {focus.map(([n, zh, en, desc, secondary]) => (
          <article>
            <span class="mono focus-number">{n}</span>
            <h3>{zh}</h3>
            <p class="focus-en" lang="en">
              {en}
            </p>
            <p>
              {desc}
              <span class="secondary-line" lang="en">
                {secondary}
              </span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="container section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / WRITING</p>
        <h2>
          最近文章 <span lang="en">Latest notes</span>
        </h2>
      </div>
      <a class="text-link" href="/blog/">
        全部文章 <span>All notes ↗</span>
      </a>
    </div>
    <PostList posts={posts} />
  </section>
  <section class="container section projects-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / SELECTED PROJECTS</p>
        <h2>
          项目展示 <span lang="en">Projects</span>
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        全部项目 <span>All projects ↗</span>
      </a>
    </div>
    <ProjectCards />
  </section>
  <section class="container contact-section">
    <div>
      <p class="eyebrow">05 / ELSEWHERE</p>
      <h2>
        保持连接<span class="accent">。</span>
        <span lang="en">Find me online.</span>
      </h2>
    </div>
    <a class="contact-link" href={site.github}>
      GitHub <span>↗</span>
      <small>github.com/chuxiaonan</small>
    </a>
  </section>
</Base>
