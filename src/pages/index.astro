---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import WorkCase from "../components/WorkCase.astro";
import ProjectCards from "../components/ProjectCards.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { site, intro } from "../data/site";
const posts = (await getPosts()).slice(0, 3);
const focus = [
  ["01", "渲染", "图形渲染与可视化"],
  ["02", "三维建模", "三维空间与模型表达"],
  ["03", "地理信息", "地理信息与 Web 地图技术"],
  ["04", "仿真", "仿真与虚拟世界构建"],
  ["05", "工程与协作", "工程落地与团队协作"],
];
---

<Base>
  <Hero />
  <section id="intro" class="container section intro">
    <div>
      <p class="eyebrow">01 / INTRODUCTION</p>
      <h2>
        以技术构建，
        <br />
        在空间中探索<span class="accent">。</span>
      </h2>
      <p class="section-subtitle" lang="en">
        Building with code. Thinking in space.
      </p>
    </div>
    <div class="intro-copy">
      <p>{intro.zh}</p>
      <p lang="en">{intro.en}</p>
      <a class="text-link" href="/about/">更多关于我</a>
    </div>
  </section>
  <section class="focus-section">
    <div class="container section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / FOCUS AREAS</p>
          <h2>技术方向</h2>
        </div>
        <p class="small-note">从像素到空间，从代码到协作。</p>
      </div>
      <div class="focus-grid">
        {
          focus.map(([n, zh, desc]) => (
            <article>
              <span class="mono focus-number">{n}</span>
              <h3>{zh}</h3>
              <p>{desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="container section work-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / SELECTED WORK</p>
        <h2>工作</h2>
      </div>
      <a class="text-link" href="/projects/">全部工作</a>
    </div>
    <WorkCase />
    <div class="archive-block">
      <h3 class="archive-heading">本站源码</h3>
      <ProjectCards variant="compact" />
    </div>
  </section>
  <section class="container section writing-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / WRITING</p>
        <h2>最近文章</h2>
      </div>
      <a class="text-link" href="/blog/">全部文章</a>
    </div>
    <PostList posts={posts} />
  </section>
  <section class="container contact-section">
    <div>
      <p class="eyebrow">05 / ELSEWHERE</p>
      <h2>
        保持连接<span class="accent">。</span>
      </h2>
    </div>
    <a class="contact-link" href={site.github} rel="noopener noreferrer">
      GitHub <span>↗</span>
      <small>github.com/chuxiaonan</small>
    </a>
  </section>
</Base>
