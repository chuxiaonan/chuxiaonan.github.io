---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../data/posts";
const posts = await getPosts();
---

<Base
  title="博客"
  description="楚骁男的技术文章与笔记，关注渲染、建模、GIS 与仿真。"
>
  <div class="hatch" aria-hidden="true"></div>
  <div class="page rule-top">
    <div class="narrow">
      <header>
        <p class="figure-label">Figure / 笔记</p>
        <h1 class="page-title">博客</h1>
        <p class="page-intro">关于渲染、建模、GIS 与仿真的记录。</p>
        <a class="text-link" href="/rss.xml">订阅 RSS</a>
      </header>
      <PostList posts={posts} />
    </div>
  </div>
</Base>
