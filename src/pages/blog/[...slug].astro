---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../data/posts";
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <div class="hatch" aria-hidden="true"></div>
  <article class="article rule-top narrow" lang={post.data.lang}>
    <a class="text-link back-link" href="/blog/">返回博客</a>
    <header class="article-header">
      <p class="figure-label">Figure / 笔记{post.data.draft && " / 草稿"}</p>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-excerpt">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <span>
            更新
            <time datetime={post.data.updatedDate.toISOString()}>
              {formatDate(post.data.updatedDate)}
            </time>
          </span>
        )}
        {post.data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
