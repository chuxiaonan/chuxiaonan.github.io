---
import Base from "../layouts/Base.astro";
---

<Base title="404 · 页面未找到">
  <div class="container page-content error-page">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>
      坐标未找到<span class="accent">。</span>
    </h1>
    <p>这个页面不存在，或已移至其他位置。</p>
    <a class="button primary" href="/">返回首页</a>
  </div>
</Base>
