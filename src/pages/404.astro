---
import Base from "../layouts/Base.astro";
---

<Base title="404 · 页面未找到">
  <div class="hatch" aria-hidden="true"></div>
  <div class="page rule-top error-page">
    <div class="narrow">
      <p class="figure-label">Figure / 404</p>
      <h1 class="page-title">坐标未找到。</h1>
      <p class="page-intro">这个页面不存在，或已移至其他位置。</p>
      <a class="button primary" href="/">返回首页</a>
    </div>
  </div>
</Base>
