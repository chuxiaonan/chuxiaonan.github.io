---
import Base from "../layouts/Base.astro";
import ProjectCards from "../components/ProjectCards.astro";
---

<Base
  title="项目 Projects"
  description="楚骁男的项目展示页面；当前项目内容为待填写的占位示例。"
>
  <div class="container page-content">
    <header class="page-heading">
      <p class="eyebrow">WORK / PROJECT INDEX</p>
      <h1>
        项目<span class="accent">。</span>
        <span lang="en">Projects</span>
      </h1>
      <p>
        项目内容待补充，以下卡片均为占位。
        <span class="secondary-line" lang="en">
          All cards below are placeholders. Project details will be added here.
        </span>
      </p>
    </header>
    <ProjectCards />
  </div>
</Base>
