---
import "../styles/global.css";
import { site } from "../data/site";
interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}
const { title, description = site.description, type = "website" } = Astro.props;
const pageTitle = title
  ? `${title} · ${site.name} Chu Xiaonan`
  : `${site.name} Chu Xiaonan · Simulation Lead`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const nav = [
  ["/", "首页"],
  ["/blog/", "博客"],
  ["/projects/", "工作"],
  ["/about/", "关于"],
];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="楚骁男 · Blog"
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="楚骁男 Chu Xiaonan，仿真项目负责人" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Chu Xiaonan" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="楚骁男 Chu Xiaonan，仿真项目负责人" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳转至内容</a>
    <header class="masthead">
      <div class="wide header-inner">
        <a class="wordmark" href="/" aria-label="楚骁男 首页">
          <span class="wordmark-glyph" aria-hidden="true">楚</span>
          楚骁男
        </a>
        <nav aria-label="主导航">
          <ul>
            {nav.map(([href, label]) => (
              <li>
                <a
                  href={href}
                  aria-current={
                    (
                      href === "/"
                        ? Astro.url.pathname === "/"
                        : Astro.url.pathname.startsWith(href!)
                    )
                      ? "page"
                      : undefined
                  }
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button
          class="theme-toggle"
          type="button"
          aria-label="切换配色主题"
          title="切换配色主题"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4M5.6 18.4l1.4-1.4m10-10 1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wide">
        <div class="footer-row">
          <span>© {new Date().getFullYear()} 楚骁男</span>
          <span>北京</span>
        </div>
        <div class="footer-meta">
          <span>Chu Xiaonan</span>
          <div>
            <a href={site.github} rel="noopener noreferrer">GitHub</a>
            <a href="/rss.xml">RSS</a>
            <a
              class="visit-count"
              href="https://hits.sh/chuxiaonan.github.io/"
              rel="noopener noreferrer"
            >
              <span aria-hidden="true">访问</span>
              <img
                src="https://hits.sh/chuxiaonan.github.io.svg?style=flat-square&label=visits&color=161616&labelColor=ffffff"
                alt="访问次数"
                height="20"
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const syncToggle = () => {
        button?.setAttribute(
          "aria-pressed",
          String(document.documentElement.dataset.theme === "dark"),
        );
      };
      syncToggle();
      button?.addEventListener("click", () => {
        const current = document.documentElement.dataset.theme ?? "light";
        const next = current === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        syncToggle();
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
