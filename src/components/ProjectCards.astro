---
import { projects } from "../data/projects";
interface Props {
  variant?: "archive" | "compact";
}
const { variant = "archive" } = Astro.props;
const items = variant === "compact" ? projects.filter((project) => project.home) : projects;
---

<ul class="record-list">
  {
    items.map((project, index) => (
      <li class="record">
        <span class="record-index">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          {project.stack && project.stack.length > 0 && (
            <div class="tags">
              {project.stack.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
        {project.year && <span class="record-year">{project.year}</span>}
        {project.links[0] && (
          <a href={project.links[0].href} rel="noopener noreferrer">
            {project.links[0].label}
          </a>
        )}
      </li>
    ))
  }
</ul>
